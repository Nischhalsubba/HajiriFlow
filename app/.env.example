HAJIRIFLOW_ENVIRONMENT=development
HAJIRIFLOW_DATABASE_URL=postgresql+psycopg://hajiriflow:hajiriflow@localhost:5432/hajiriflow
HAJIRIFLOW_SESSION_SECRET=replace-with-at-least-32-random-characters
HAJIRIFLOW_TIMEZONE=Asia/Kathmandu
HAJIRIFLOW_LOG_LEVEL=INFO
HAJIRIFLOW_SESSION_TTL_MINUTES=480
HAJIRIFLOW_LOGIN_WINDOW_SECONDS=900
HAJIRIFLOW_LOGIN_MAX_ATTEMPTS=5
HAJIRIFLOW_SESSION_COOKIE_NAME=hajiriflow_session
HAJIRIFLOW_CSRF_COOKIE_NAME=hajiriflow_csrf
HAJIRIFLOW_COOKIE_SECURE=false
HAJIRIFLOW_COOKIE_SAME_SITE=lax
HAJIRIFLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://hajiriflow.netlify.app
